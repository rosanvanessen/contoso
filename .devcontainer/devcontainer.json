{
  "name": "Contoso · GitHub Copilot Advanced Workshop",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Contoso app", "onAutoForward": "notify" }
  },
  "postCreateCommand": "bash scripts/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot-chat",
        "GitHub.vscode-pull-request-github",
        "GitHub.vscode-github-actions",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-bicep"
      ],
      "settings": {
        "files.exclude": { "**/node_modules": true },
        "editor.formatOnSave": false,
        "chat.mcp.workspaceRootConfig.enabled": true
      }
    }
  }
}
